# ───────────── EXAMIA — configuration serveur ─────────────
# Ce fichier est lu UNIQUEMENT par le serveur Node. Les clés ne sont jamais
# envoyées au navigateur. Copiez-le en `.env` et complétez.

# Clé API Anthropic (Claude). Sans clé, EXAMIA fonctionne en « mode démo »
# avec un générateur local simplifié.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération des QCM.
EXAMIA_MODEL=claude-opus-5-5

# Niveau d'effort de raisonnement : low | medium | high | xhigh | max
EXAMIA_EFFORT=high

# Port du serveur API
PORT=3001

# Dossier de données (base SQLite + fichiers importés)
DATA_DIR=./data

# Taille max d'un fichier importé (Mo)
MAX_UPLOAD_MB=50

# Code d'accès demandé à l'ouverture de l'application. Laissez vide en local,
# OBLIGATOIRE dès que l'application est en ligne (sinon n'importe qui peut
# l'utiliser et consommer votre crédit IA).
EXAMIA_ACCESS_CODE=

# Secret de signature des sessions (généré automatiquement si vide).
SESSION_SECRET=
